# This .gitignore is for Unity projects
# ================================================================================

# ================================================================================
# Unity generated artifacts
# ================================================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ================================================================================
# Unity Package Manager (UPM) Cache & Dependencies
# ================================================================================
Packages/PackageCache/
!Packages/manifest.json
!Packages/packages-lock.json

# ================================================================================
# Unity generated visual studio / IDE files
# ================================================================================
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userossc
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta
*.opendb
*.VC.db
/.vs/

# ================================================================================
# JetBrains Rider
# ================================================================================
.idea/
*.sln.DotSettings.user

# ================================================================================
# VS Code
# ================================================================================
.vscode/

# ================================================================================
# OS generated
# ================================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
[Dd]esktop.ini

# ================================================================================
# Unity specific
# ================================================================================
# Asset meta data should only be ignored when selectively
!/Assets/**/*.meta

# Crash Reports
/crashlytics/
crashlytics-build.properties

# Screenshots (not needed in version control)
Assets/Screenshots/
Assets/Screenshots.meta

# Unity recovery files from crashes
Assets/_Recovery/
Assets/_Recovery.meta

# Scene templates (auto-generated by Unity)
Assets/Settings/Scenes/
Assets/Settings/Scenes.meta
Assets/Settings/Lit2DSceneTemplate.scenetemplate*
ProjectSettings/SceneTemplateSettings.json

# Unity Test Runner & Performance Testing artifacts
Assets/Resources/PerformanceTestRunInfo.json*
Assets/Resources/PerformanceTestRunSettings.json*

# Gradle build artifacts (Android)
gradle/
.gradle/
local.properties
*.apk
*.aab

# iOS / macOS
*.app
*.ipa
*.dSYM.zip
*.dSYM

# Burst & IL2CPP debug / backup folders
**/*BurstDebugInformation_DoNotShip*
**/*BackUpThisFolder_ButDontShipItWithYourGame*

# Unity Android temp
.utmp/
*.so

# Packages export
*.unitypackage
